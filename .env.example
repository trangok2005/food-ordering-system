# ====== CSDL MySQL ======
DATABASE_USERNAME=root
DATABASE_PASSWORD=root
DATABASE_HOST=127.0.0.1
DATABASE_NAME=tvtfooddb
DATABASE_PORT=3306

# ====== Thanh toan payOS ======
# mock = cong thanh toan gia lap trong app (demo local, khong ton tien)
# live = goi API payOS that (chi bat khi deploy public)
PAYOS_MODE=mock
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# ====== Dang nhap Google OAuth ======
# Redirect URI khai bao tren Google Console:
#   http://127.0.0.1:5000/auth/login/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ====== Gemini AI (phan tich cam xuc binh luan) ======
GEMINI_API_KEY=your_gemini_api_key
# De trong thi dung mac dinh gemini-3.6-flash
GEMINI_MODEL=

# ====== Cloudinary (chua dung, de phong huu) ======
cloud_name=your_cloud_name
api_key=your_cloudinary_api_key
